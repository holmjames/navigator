{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "prospect",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "persona": {
      "type": "string"
    },
    "persona_rank": {
      "type": "integer"
    },
    "owns": {
      "type": "string"
    },
    "recent_public_topics": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "time_in_role_note": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "persona",
    "persona_rank",
    "owns",
    "recent_public_topics",
    "time_in_role_note"
  ]
}